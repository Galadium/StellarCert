# Soroban Integration Environment Variables
#
# This file is merged/consolidated into the root .env.example template.
# Keep this file in sync with the Soroban block in .env.example.
#
# All values below are FAKE development defaults. Do NOT use them in production.

# Enable Soroban smart contract integration
ENABLE_SOROBAN_INTEGRATION=true

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Admin secret key for contract operations (keep secure!)
# This value is NEVER echoed by deploy-contracts.sh. Reuse the secret you
# supplied via SOROBAN_ADMIN_SECRET or the --admin-secret flag. If the script
	# writes it to a file, the path is reported as 0600 and must be sourced manually.
SOROBAN_ADMIN_SECRET=your_admin_secret_key_here

# Deployed contract IDs obtained from the deployment script)
CERTIFICATE_CONTRACT_ID=CCERTIFICATE_CONTRACT_ID_HERE
MULTISIG_CONTRACT_ID=CMUITISIG_CONTRACT_ID_HERE
CRL_CONTRACT_ID=CCRL_CONTRACT_ID_HERE

# Existing Stellar configuration
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet
STELLAR_ISSUER_SECRET_KEY=your_issuer_secret_key
